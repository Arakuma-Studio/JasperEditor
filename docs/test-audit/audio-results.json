    "compatibilityProbeModule": "import {createHash} from 'node:crypto';\nimport {renderSynth,SYNTH_RECIPES,SYNTH_EXTRA_RECIPES,SYNTH_VARIANTS} from './packages/audio-fx/src/synth/render.ts';\nimport {encodeWav} from './packages/audio-dsp/src/wav.ts';\nfor(const recipe of [...SYNTH_RECIPES,...SYNTH_EXTRA_RECIPES]){\n const raw=createHash('sha256');\n const variants=[];\n for(let seed=0;seed<SYNTH_VARIANTS;seed++){\n  const sound=renderSynth(recipe.id,seed);\n  for(const channel of sound.channels) raw.update(new Uint8Array(channel.buffer,channel.byteOffset,channel.byteLength));\n  variants.push({seed,wav:createHash('sha256').update(encodeWav(sound.channels,sound.sampleRate,'s16')).digest('hex')});\n }\n console.log(JSON.stringify({recipe:recipe.id,float:raw.digest('hex').slice(0,32),variants}));\n}\n"
  }
