            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -4000,
              "maximum": 4000
            }
          },
          "holdUntilFrames": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 432000
          }
        },
        "additionalProperties": false
      },
      "defaults": {
        "name": "Alex Morgan",
        "title": "Producer, JasperEditor",
        "accentColor": [0.22, 0.53, 1, 1],
        "textColor": [1, 1, 1, 1],
        "backgroundColor": [0.04, 0.06, 0.12, 0.78],
        "position": [120, 800],
        "holdUntilFrames": 0
      },
