              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "textColor": {
            "default": [1, 1, 1, 1],
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "backgroundColor": {
            "default": [0.04, 0.06, 0.12, 0.78],
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "position": {
            "default": [120, 800],
