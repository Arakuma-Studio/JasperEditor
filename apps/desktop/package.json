{
  "name": "@jasper/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "build": "node scripts/build-main.mjs",
    "dev": "node scripts/build-main.mjs && electron .",
    "start:packaged-like": "node scripts/build-main.mjs && cross-env JASPER_DESKTOP_MODE=packaged-like electron .",
    "dist:dir": "node scripts/package.mjs --dir",
    "dist": "node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "esbuild": "^0.25.0"
  },
  "description": "JasperEditor desktop shell (Electron): loads the SPA from the dev server or a forked engine.",
  "build": {
    "appId": "com.jasper.editor",
    "productName": "JasperEditor",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist-electron/**/*",
      "package.json",
      "!**/node_modules/@remotion/compositor-*/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../engine/dist-deploy",
        "to": "engine"
      },
      {
        "from": "../engine/dist-deploy/node_modules",
        "to": "engine/node_modules",
        "filter": [
          "**/*",
          "!@remotion/compositor-*/**",
          "!**/@remotion/compositor-*/**"
        ]
      },
      {
        "from": "../mcp/dist",
        "to": "mcp",
        "filter": [
          "jasper-mcp.mjs"
        ]
      },
      {
        "from": "../../native/bin/${os}-${arch}",
        "to": "bin"
      },
      {
        "from": "../../vendor/ffmpeg-lgpl/.package/${os}-${arch}",
        "to": "ffmpeg-lgpl"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "executableName": "jasper-editor"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true
    },
    "fileAssociations": [
      {
        "ext": "jasper",
        "name": "JasperEditor Project",
        "role": "Editor"
      }
    ],
    "afterPack": "./scripts/after-pack.cjs"
  }
}
