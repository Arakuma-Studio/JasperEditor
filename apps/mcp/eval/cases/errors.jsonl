{"id": "stale-engine-route", "kind": "guard", "what": "A 404 from an older engine carried the hint \"Unknown sound or folder id\", which is about something else.", "text": "ENGINE_ERROR_HINTS.NOT_FOUND / sound hint", "source": "chat in JasperEditor, 2026-10-30: list_sound_packs against an engine older than the server; the agent retried both tools, then searched the disk", "prompt": "What sound packs do I have installed?", "setup": {"project": "interview", "toolsets": "sound", "faults": {"listSoundPacks": {"error": {"code": "NOT_FOUND", "message": "No route for GET /api/sounds/packs", "status": 404}}, "soundLibraryStatus": {"error": {"code": "NOT_FOUND", "message": "No route for GET /api/sounds/status", "status": 404}}}}, "checks": {"calls": [{"tool": "list_sound_packs"}], "replyMust": ["engine|restart|version|older|outdated|update"], "maxCalls": 6, "maxCallsOf": {"list_sound_packs": 1, "sound_library_status": 1}}}
{"id": "approval-denied-no-retry", "kind": "guard", "what": "After E_APPROVAL_DENIED the agent stops and tells the user.", "text": "E_APPROVAL_DENIED hint", "source": "commit 78d1e43b; instructions rule", "prompt": "Delete track V3.", "setup": {"project": "interview", "faults": {"tx:track.remove": {"error": {"code": "E_APPROVAL_DENIED", "message": "The user denied this change"}}}}, "checks": {"calls": [{"tool": ["delete_tracks", "apply_commands"]}], "maxCallsOf": {"delete_tracks": 1}, "mustNotCall": [{"tool": "apply_commands", "args": {"commands": [{"force": true}]}}], "replyMust": ["denied|approv|declin|rejected"]}}
{"id": "connection-lost-no-reapply", "kind": "guard", "what": "A write cut off mid-flight may have landed: read before retrying.", "text": "ABORT_HINTS.connection-lost", "source": "commit 60a56325 \"never blindly re-send a write\"", "prompt": "Add interview-b.mp4 to track V2 at 20 seconds.", "setup": {"project": "interview", "faults": {"agentTx": {"abort": "connection-lost", "afterApply": true, "times": 1}}}, "checks": {"order": ["add_clip", "get_timeline"], "maxCallsOf": {"add_clip": 1}}}
{"id": "undo-not-owner", "kind": "guard", "what": "Undo only touches this agent's entries: E_NOT_OWNER ends the attempt.", "text": "E_NOT_OWNER hint", "source": "instructions rule", "prompt": "Undo that.", "setup": {"project": "interview", "faults": {"tx:history.undo": {"error": {"code": "E_NOT_OWNER", "message": "The top history entry was made by the user"}}}}, "checks": {"calls": [{"tool": "undo"}], "maxCallsOf": {"undo": 1}, "replyMust": ["your|user|another|not (mine|made by me)|own"]}, "priorTurns": [{"role": "user", "text": "I just changed something on the timeline myself in the editor window."}, {"role": "assistant", "text": "Understood. Tell me if you want anything changed."}]}
