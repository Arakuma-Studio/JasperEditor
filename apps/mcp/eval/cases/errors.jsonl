{"id": "stale-engine-route", "kind": "bad", "what": "A 404 from an older engine carried the hint \"Unknown sound or folder id\", which is about something else.", "text": "ENGINE_ERROR_HINTS.NOT_FOUND / sound hint", "source": "chat in JasperEditor, 2026-10-30: list_sound_packs against an engine older than the server; the agent retried both tools, then searched the disk; baseline on d802faed: codex 0/2", "prompt": "What sound packs do I have installed?", "setup": {"project": "interview", "toolsets": "sound", "faults": {"listSoundPacks": {"error": {"code": "NOT_FOUND", "message": "No route for GET /api/sounds/packs", "status": 404}}, "soundLibraryStatus": {"error": {"code": "NOT_FOUND", "message": "No route for GET /api/sounds/status", "status": 404}}}}, "checks": {"calls": [{"tool": "list_sound_packs"}], "replyMust": ["engine|restart|version|older|outdated|update"], "maxCalls": 6, "maxCallsOf": {"list_sound_packs": 1, "sound_library_status": 1}}}
{"id": "approval-denied-no-retry", "kind": "guard", "what": "After E_APPROVAL_DENIED the agent stops and tells the user.", "text": "E_APPROVAL_DENIED hint", "source": "commit 78d1e43b; instructions rule", "prompt": "Delete track V3.", "setup": {"project": "interview", "faults": {"tx:track.remove": {"error": {"code": "E_APPROVAL_DENIED", "message": "The user denied this change"}}}}, "checks": {"calls": [{"tool": ["delete_tracks", "apply_commands"]}], "maxCallsOf": {"delete_tracks": 1}, "mustNotCall": [{"tool": "apply_commands", "args": {"commands": [{"force": true}]}}], "replyMust": ["denied|approv|declin|rejected"]}}
{"id": "connection-lost-no-reapply", "kind": "guard", "what": "A write cut off mid-flight may have landed: read before retrying.", "text": "ABORT_HINTS.connection-lost", "source": "commit 60a56325 \"never blindly re-send a write\"", "prompt": "Add interview-b.mp4 to track V2 at 20 seconds.", "setup": {"project": "interview", "faults": {"agentTx": {"abort": "connection-lost", "afterApply": true, "times": 1}}}, "checks": {"calls": [{"tool": "add_clip"}, {"tool": ["get_timeline", "get_project"]}], "maxCallsOf": {"add_clip": 1}}}
{"id": "undo-not-owner", "kind": "bad", "what": "The agent undoes its own edit, but the user edited after it: E_NOT_OWNER ends the attempt.", "text": "E_NOT_OWNER hint", "source": "instructions rule; baseline on d802faed: codex 1/3, it reverted the edit by hand and never said undo was refused", "prompt": "Actually, undo that.", "setup": {"project": "interview", "faults": {"tx:history.undo": {"error": {"code": "E_NOT_OWNER", "message": "The top history entry was made by the user"}}}, "seed": [{"type": "marker.add", "frame": 150, "name": "Intro"}]}, "checks": {"calls": [{"tool": "undo"}], "maxCallsOf": {"undo": 2}, "replyMust": ["user|your|you made|someone|not mine|another"]}, "priorTurns": [{"role": "user", "text": "Add a marker named Intro at 5 seconds."}, {"role": "assistant", "text": "Added the Intro marker at 5 seconds.", "calls": [{"tool": "apply_commands", "args": {"projectId": "{{project}}", "label": "Add Intro marker", "commands": [{"type": "marker.add", "frame": {"seconds": 5}, "name": "Intro"}]}, "result": "{\"ok\":true,\"appliedBy\":\"session\",\"appliedLive\":true,\"revision\":2,\"created\":[\"mrk_0000000000000021\"],\"changed\":[],\"deleted\":[]}"}]}]}
